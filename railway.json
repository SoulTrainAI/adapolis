{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm run build"
  },
  "deploy": {
    "startCommand": "npm run start",
    "numReplicas": 1,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "cronJobs": [
      {
        "name": "sync-and-score",
        "schedule": "0 */6 * * *",
        "command": "curl -X POST https://www.adapolis.net/api/cron -H \"Authorization: Bearer $CRON_SECRET\""
      },
      {
        "name": "votes-hourly",
        "schedule": "20 * * * *",
        "command": "curl -X POST https://www.adapolis.net/api/cron/votes -H \"Authorization: Bearer $CRON_SECRET\""
      }
    ]
  }
}
