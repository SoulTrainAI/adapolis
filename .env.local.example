# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase Service Role (server-side only, never expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Koios API (optional — higher rate limits with key, public access without)
KOIOS_API_KEY=

# Anthropic API
ANTHROPIC_API_KEY=your-anthropic-api-key

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ETL/Cron Protection
CRON_SECRET=your-secret-cron-token

# AI stated-position summaries: daily | weekly | on (every 6h refresh). Unset = off.
STATEMENT_SUMMARIES=

# Epoch Season 1 (fantasy drafting) starts. Unset = preview seasons only.
SEASON_ONE_START_EPOCH=
